{
    "name": "ziming/laravel-myinfo-sg",
    "description": "Laravel Package for Singapore MyInfo",
    "keywords": [
        "ziming",
        "laravel-myinfo-sg"
    ],
    "homepage": "https://github.com/ziming/laravel-myinfo-sg",
    "type": "library",
    "authors": [
        {
            "name": "Ziming",
            "email": "ziming.opensource@gmail.com",
            "role": "Package Uploader"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "archtechx/enums": "^1.0",
        "guzzlehttp/guzzle": "^7.15.3||^8.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.16.6",
        "spomky-labs/aes-key-wrap": "^7.0 || ^8.0",
        "web-token/jwt-framework": "^4.0",
        "saloonphp/cache-plugin": "^3.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.37.1",
        "symfony/thanks": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Ziming\\LaravelMyinfoSg\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ziming\\LaravelMyinfoSg\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/thanks": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ziming\\LaravelMyinfoSg\\LaravelMyinfoSgServiceProvider"
            ],
            "aliases": {
                "LaravelMyinfoSg": "Ziming\\LaravelMyinfoSg\\LaravelMyinfoSgFacade"
            }
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit --no-coverage"
    }
}
